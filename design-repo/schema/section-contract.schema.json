{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "$id": "section-contract.schema.json",
 "title": "Section contract",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "id",
  "version",
  "title",
  "source",
  "semantic",
  "retrievalEligible",
  "content",
  "constraints",
  "responsive",
  "motion",
  "generatedAssetRoles",
  "referenceAssetRoles",
  "tokens",
  "composes",
  "evidence",
  "measured"
 ],
 "properties": {
  "id": {
   "type": "string",
   "pattern": "^[a-z]+\\.[a-z0-9-]+$"
  },
  "version": {
   "type": "string"
  },
  "title": {
   "type": "string"
  },
  "source": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "id",
    "root",
    "file",
    "lines",
    "tag"
   ],
   "properties": {
    "id": {
     "type": "string"
    },
    "root": {
     "enum": [
      "project",
      "repo"
     ]
    },
    "file": {
     "type": "string"
    },
    "lines": {
     "type": "string",
     "pattern": "^[0-9]+(-[0-9]+)?$"
    },
    "tag": {
     "type": "string",
     "minLength": 3
    },
    "note": {
     "type": "string"
    }
   }
  },
  "semantic": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "id",
    "category",
    "purpose"
   ],
   "properties": {
    "id": {
     "type": "string"
    },
    "category": {
     "enum": [
      "SHELL",
      "HERO",
      "CONTENT",
      "PORTFOLIO",
      "PROJECT_DETAIL",
      "MEDIA",
      "PROFILE",
      "NAVIGATION",
      "NOTICE",
      "UTILITY"
     ]
    },
    "purpose": {
     "type": "string",
     "minLength": 10
    }
   }
  },
  "retrievalEligible": {
   "type": "boolean"
  },
  "retrievalIneligibleReason": {
   "type": "string",
   "minLength": 30
  },
  "content": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "fields"
   ],
   "properties": {
    "fields": {
     "type": "object"
    }
   }
  },
  "constraints": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "onePerPage": {
     "type": "boolean"
    },
    "mustBeFirst": {
     "type": "boolean"
    },
    "mustBeLast": {
     "type": "boolean"
    },
    "homeOnly": {
     "type": "boolean"
    }
   }
  },
  "responsive": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "desktop",
    "mobile",
    "breakpoint"
   ],
   "properties": {
    "desktop": {
     "type": "string"
    },
    "mobile": {
     "type": "string"
    },
    "breakpoint": {
     "type": [
      "string",
      "null"
     ]
    }
   }
  },
  "motion": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "patterns",
    "default",
    "reducedMotionFallback",
    "sourceImplementsFallback"
   ],
   "properties": {
    "patterns": {
     "type": "array",
     "minItems": 1,
     "items": {
      "enum": [
       "backdrop-fade",
       "content-crossfade",
       "floating-digits",
       "gallery-strip-scroll",
       "hover-focus-blur",
       "kinetic-cursor",
       "none",
       "opacity-hover",
       "page-transition-wipe",
       "plane-focus-stage",
       "preloader-wipe",
       "staggered-fade-up",
       "word-reveal"
      ]
     }
    },
    "default": {
     "enum": [
      "backdrop-fade",
      "content-crossfade",
      "floating-digits",
      "gallery-strip-scroll",
      "hover-focus-blur",
      "kinetic-cursor",
      "none",
      "opacity-hover",
      "page-transition-wipe",
      "plane-focus-stage",
      "preloader-wipe",
      "staggered-fade-up",
      "word-reveal"
     ]
    },
    "reducedMotionFallback": {
     "enum": [
      "crossfade-stage",
      "instant-hide",
      "instant-route-change",
      "instant-show",
      "no-blur-highlight",
      "none",
      "opacity-fade",
      "opacity-hover",
      "snap-follow",
      "static-digits",
      "static-strip"
     ]
    },
    "sourceImplementsFallback": {
     "type": "boolean"
    }
   }
  },
  "generatedAssetRoles": {
   "type": "array",
   "items": {
    "enum": [
     "brand.favicon-source",
     "brand.wordmark-placeholder",
     "brand.wordmark-source",
     "copy.original",
     "discipline.media-generated",
     "discipline.media-source",
     "link.placeholder-url",
     "media.placeholder",
     "person.portrait-fictional",
     "person.portrait-source",
     "project.cover-generated",
     "project.cover-source",
     "project.gallery-generated",
     "project.gallery-source",
     "project.video-generated",
     "project.video-source",
     "rating.placeholder",
     "scene.procedural-digits"
    ]
   }
  },
  "referenceAssetRoles": {
   "type": "array",
   "items": {
    "enum": [
     "brand.favicon-source",
     "brand.wordmark-placeholder",
     "brand.wordmark-source",
     "copy.original",
     "discipline.media-generated",
     "discipline.media-source",
     "link.placeholder-url",
     "media.placeholder",
     "person.portrait-fictional",
     "person.portrait-source",
     "project.cover-generated",
     "project.cover-source",
     "project.gallery-generated",
     "project.gallery-source",
     "project.video-generated",
     "project.video-source",
     "rating.placeholder",
     "scene.procedural-digits"
    ]
   }
  },
  "tokens": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "composes": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "evidence": {
   "type": "array",
   "items": {
    "$ref": "#/definitions/citation"
   }
  },
  "measured": {
   "type": "object"
  },
  "notes": {
   "type": "string"
  }
 },
 "allOf": [
  {
   "if": {
    "properties": {
     "retrievalEligible": {
      "const": false
     }
    }
   },
   "then": {
    "required": [
     "retrievalIneligibleReason"
    ]
   }
  }
 ],
 "definitions": {
  "citation": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "root",
    "file",
    "lines",
    "tag"
   ],
   "properties": {
    "root": {
     "enum": [
      "project",
      "repo"
     ]
    },
    "file": {
     "type": "string"
    },
    "lines": {
     "type": "string",
     "pattern": "^[0-9]+(-[0-9]+)?$"
    },
    "tag": {
     "type": "string"
    },
    "note": {
     "type": "string"
    }
   }
  }
 }
}
