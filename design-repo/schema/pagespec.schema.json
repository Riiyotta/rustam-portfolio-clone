{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "$id": "pagespec.schema.json",
 "title": "PageSpec (portfolio design-repo)",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "pageSpecVersion",
  "mode",
  "template",
  "route",
  "theme",
  "meta",
  "nodes"
 ],
 "properties": {
  "pageSpecVersion": {
   "const": "1.0.0"
  },
  "mode": {
   "type": "string",
   "enum": [
    "reference",
    "generated"
   ],
   "description": "reference = faithful reconstruction of the source (evidence); generated = a new page for someone else, carrying no source identity or content."
  },
  "template": {
   "type": "string",
   "enum": [
    "about",
    "home",
    "not-found",
    "project-detail"
   ]
  },
  "route": {
   "type": "string",
   "minLength": 1
  },
  "theme": {
   "type": "string",
   "enum": [
    "dark"
   ]
  },
  "meta": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "title",
    "description"
   ],
   "properties": {
    "title": {
     "type": "string",
     "minLength": 1,
     "maxLength": 70
    },
    "description": {
     "type": "string",
     "minLength": 1,
     "maxLength": 160
    }
   }
  },
  "runtimeLayers": {
   "type": "array",
   "uniqueItems": true,
   "items": {
    "type": "string",
    "enum": [
     "utility.preloader",
     "utility.kinetic-cursor",
     "utility.page-transition",
     "utility.overlay-backdrop",
     "utility.hover-title",
     "utility.toast"
    ]
   }
  },
  "nodes": {
   "type": "array",
   "minItems": 1,
   "items": {
    "$ref": "#/definitions/node"
   }
  }
 },
 "definitions": {
  "assetRole": {
   "type": "string",
   "enum": [
    "brand.favicon-source",
    "brand.wordmark-placeholder",
    "brand.wordmark-source",
    "copy.original",
    "discipline.media-generated",
    "discipline.media-source",
    "link.placeholder-url",
    "media.placeholder",
    "person.portrait-fictional",
    "person.portrait-source",
    "project.cover-generated",
    "project.cover-source",
    "project.gallery-generated",
    "project.gallery-source",
    "project.video-generated",
    "project.video-source",
    "rating.placeholder",
    "scene.procedural-digits"
   ]
  },
  "asset": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "assetRole",
    "src",
    "alt"
   ],
   "properties": {
    "assetRole": {
     "$ref": "#/definitions/assetRole"
    },
    "src": {
     "type": "string",
     "minLength": 1
    },
    "alt": {
     "type": "string"
    }
   }
  },
  "motion": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "pattern",
    "reducedMotionFallback"
   ],
   "properties": {
    "pattern": {
     "type": "string",
     "enum": [
      "backdrop-fade",
      "content-crossfade",
      "floating-digits",
      "gallery-strip-scroll",
      "hover-focus-blur",
      "kinetic-cursor",
      "none",
      "opacity-hover",
      "page-transition-wipe",
      "plane-focus-stage",
      "preloader-wipe",
      "staggered-fade-up",
      "word-reveal"
     ]
    },
    "reducedMotionFallback": {
     "type": "string",
     "enum": [
      "crossfade-stage",
      "instant-hide",
      "instant-route-change",
      "instant-show",
      "no-blur-highlight",
      "none",
      "opacity-fade",
      "opacity-hover",
      "snap-follow",
      "static-digits",
      "static-strip"
     ]
    },
    "trigger": {
     "type": "string",
     "enum": [
      "load",
      "hover",
      "wheel",
      "click",
      "route-change",
      "loop"
     ]
    }
   }
  },
  "tokens": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "textColor": {
     "type": "string",
     "minLength": 1
    },
    "surface": {
     "type": "string",
     "minLength": 1
    },
    "border": {
     "type": "string",
     "minLength": 1
    },
    "fontFamily": {
     "type": "string",
     "minLength": 1
    },
    "typeScale": {
     "type": "string",
     "minLength": 1
    },
    "fontWeight": {
     "type": "string",
     "minLength": 1
    },
    "spacing": {
     "type": "string",
     "minLength": 1
    },
    "motionEasing": {
     "type": "string",
     "minLength": 1
    }
   }
  },
  "node": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "section",
    "content",
    "motion"
   ],
   "properties": {
    "section": {
     "type": "string",
     "enum": [
      "shell.navbar",
      "hero.intro",
      "content.intro-note",
      "portfolio.work-index",
      "shell.footer-contact",
      "project.header",
      "project.media-stage",
      "project.meta",
      "project.footer-bar",
      "about.profile-header",
      "about.media-stage",
      "about.discipline-list",
      "about.footer-meta",
      "notfound.digits-scene",
      "notfound.message"
     ]
    },
    "variant": {
     "type": "string",
     "enum": [
      "default"
     ]
    },
    "content": {
     "type": "object"
    },
    "motion": {
     "$ref": "#/definitions/motion"
    },
    "tokens": {
     "$ref": "#/definitions/tokens"
    }
   },
   "allOf": [
    {
     "if": {
      "properties": {
       "section": {
        "const": "shell.navbar"
       }
      },
      "required": [
       "section"
      ]
     },
     "then": {
      "properties": {
       "content": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
         "ownerName": {
          "type": "string",
          "minLength": 1
         },
         "occupation": {
          "type": "string",
          "minLength": 1
         },
         "location": {
          "type": "string",
          "minLength": 1
         },
         "contactLinks": {
          "type": "array",
          "items": {
           "type": "object",
           "additionalProperties": false,
           "properties": {
            "label": {
             "type": "string",
             "minLength": 1
            },
            "href": {
             "type": "string",
             "minLength": 1
            },
            "kind": {
             "type": "string",
             "enum": [
              "copy-email",
              "social",
              "external",
              "internal"
             ]
            }
           },
           "required": [
            "href",
            "kind",
            "label"
           ]
          },
          "maxItems": 3
         },
         "profileLinkLabel": {
          "type": "string",
          "minLength": 1
         }
        },
        "required": [
         "location",
         "occupation",
         "ownerName",
         "profileLinkLabel"
        ]
       },
       "motion": {
        "properties": {
         "pattern": {
          "enum": [
           "staggered-fade-up",
           "opacity-hover"
          ]
         }
        }
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "section": {
        "const": "hero.intro"
       }
      },
      "required": [
       "section"
      ]
     },
     "then": {
      "properties": {
       "content": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
         "headingLines": {
          "type": "array",
          "items": {
           "type": "string",
           "minLength": 1
          },
          "minItems": 1,
          "maxItems": 3
         },
         "portrait": {
          "$ref": "#/definitions/asset"
         },
         "profileHref": {
          "type": "string",
          "minLength": 1
         }
        },
        "required": [
         "headingLines",
         "portrait",
         "profileHref"
        ]
       },
       "motion": {
        "properties": {
         "pattern": {
          "enum": [
           "word-reveal"
          ]
         }
        }
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "section": {
        "const": "content.intro-note"
       }
      },
      "required": [
       "section"
      ]
     },
     "then": {
      "properties": {
       "content": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
         "text": {
          "type": "string",
          "minLength": 1
         }
        },
        "required": [
         "text"
        ]
       },
       "motion": {
        "properties": {
         "pattern": {
          "enum": [
           "word-reveal"
          ]
         }
        }
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "section": {
        "const": "portfolio.work-index"
       }
      },
      "required": [
       "section"
      ]
     },
     "then": {
      "properties": {
       "content": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
         "heading": {
          "type": "string",
          "minLength": 1
         },
         "items": {
          "type": "array",
          "items": {
           "type": "object",
           "additionalProperties": false,
           "properties": {
            "title": {
             "type": "string",
             "minLength": 1
            },
            "href": {
             "type": "string",
             "minLength": 1
            },
            "cover": {
             "$ref": "#/definitions/asset"
            }
           },
           "required": [
            "cover",
            "href",
            "title"
           ]
          },
          "minItems": 1,
          "maxItems": 12
         }
        },
        "required": [
         "items"
        ]
       },
       "motion": {
        "properties": {
         "pattern": {
          "enum": [
           "gallery-strip-scroll",
           "hover-focus-blur"
          ]
         }
        }
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "section": {
        "const": "shell.footer-contact"
       }
      },
      "required": [
       "section"
      ]
     },
     "then": {
      "properties": {
       "content": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
         "servicesHeading": {
          "type": "string",
          "minLength": 1
         },
         "services": {
          "type": "array",
          "items": {
           "type": "string",
           "minLength": 1
          },
          "maxItems": 6
         },
         "connectHeading": {
          "type": "string",
          "minLength": 1
         },
         "contactLinks": {
          "type": "array",
          "items": {
           "type": "object",
           "additionalProperties": false,
           "properties": {
            "label": {
             "type": "string",
             "minLength": 1
            },
            "href": {
             "type": "string",
             "minLength": 1
            },
            "kind": {
             "type": "string",
             "enum": [
              "copy-email",
              "social",
              "external",
              "internal"
             ]
            }
           },
           "required": [
            "href",
            "kind",
            "label"
           ]
          },
          "maxItems": 3
         },
         "creditLabel": {
          "type": "string",
          "minLength": 1
         },
         "credit": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
           "label": {
            "type": "string",
            "minLength": 1
           },
           "href": {
            "type": "string",
            "minLength": 1
           }
          },
          "required": [
           "href",
           "label"
          ]
         }
        }
       },
       "motion": {
        "properties": {
         "pattern": {
          "enum": [
           "opacity-hover"
          ]
         }
        }
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "section": {
        "const": "project.header"
       }
      },
      "required": [
       "section"
      ]
     },
     "then": {
      "properties": {
       "content": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
         "title": {
          "type": "string",
          "minLength": 1
         },
         "description": {
          "type": "string",
          "minLength": 1
         },
         "tags": {
          "type": "array",
          "items": {
           "type": "string",
           "minLength": 1
          },
          "maxItems": 5
         }
        },
        "required": [
         "description",
         "title"
        ]
       },
       "motion": {
        "properties": {
         "pattern": {
          "enum": [
           "word-reveal"
          ]
         }
        }
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "section": {
        "const": "project.media-stage"
       }
      },
      "required": [
       "section"
      ]
     },
     "then": {
      "properties": {
       "content": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
         "media": {
          "type": "array",
          "items": {
           "type": "object",
           "additionalProperties": false,
           "properties": {
            "asset": {
             "$ref": "#/definitions/asset"
            },
            "kind": {
             "type": "string",
             "enum": [
              "image",
              "video"
             ]
            }
           },
           "required": [
            "asset",
            "kind"
           ]
          },
          "minItems": 1,
          "maxItems": 11
         }
        },
        "required": [
         "media"
        ]
       },
       "motion": {
        "properties": {
         "pattern": {
          "enum": [
           "plane-focus-stage"
          ]
         }
        }
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "section": {
        "const": "project.meta"
       }
      },
      "required": [
       "section"
      ]
     },
     "then": {
      "properties": {
       "content": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
         "yearLabel": {
          "type": "string",
          "minLength": 1
         },
         "year": {
          "type": "string",
          "pattern": "^[0-9]{4}$"
         },
         "toolsLabel": {
          "type": "string",
          "minLength": 1
         },
         "tools": {
          "type": "string",
          "minLength": 1
         }
        },
        "required": [
         "tools",
         "year"
        ]
       },
       "motion": {
        "properties": {
         "pattern": {
          "enum": [
           "word-reveal"
          ]
         }
        }
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "section": {
        "const": "project.footer-bar"
       }
      },
      "required": [
       "section"
      ]
     },
     "then": {
      "properties": {
       "content": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
         "hint": {
          "type": "string",
          "minLength": 1
         },
         "tags": {
          "type": "array",
          "items": {
           "type": "string",
           "minLength": 1
          },
          "maxItems": 5
         },
         "mediaCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 11
         }
        },
        "required": [
         "hint",
         "mediaCount"
        ]
       },
       "motion": {
        "properties": {
         "pattern": {
          "enum": [
           "opacity-hover"
          ]
         }
        }
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "section": {
        "const": "about.profile-header"
       }
      },
      "required": [
       "section"
      ]
     },
     "then": {
      "properties": {
       "content": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
         "title": {
          "type": "string",
          "minLength": 1
         },
         "intro": {
          "type": "string",
          "minLength": 1
         },
         "description": {
          "type": "string",
          "minLength": 1
         }
        },
        "required": [
         "description",
         "intro",
         "title"
        ]
       },
       "motion": {
        "properties": {
         "pattern": {
          "enum": [
           "word-reveal",
           "content-crossfade"
          ]
         }
        }
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "section": {
        "const": "about.media-stage"
       }
      },
      "required": [
       "section"
      ]
     },
     "then": {
      "properties": {
       "content": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
         "media": {
          "type": "array",
          "items": {
           "type": "object",
           "additionalProperties": false,
           "properties": {
            "asset": {
             "$ref": "#/definitions/asset"
            },
            "kind": {
             "type": "string",
             "enum": [
              "image",
              "video"
             ]
            }
           },
           "required": [
            "asset",
            "kind"
           ]
          },
          "minItems": 1,
          "maxItems": 8
         }
        },
        "required": [
         "media"
        ]
       },
       "motion": {
        "properties": {
         "pattern": {
          "enum": [
           "plane-focus-stage"
          ]
         }
        }
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "section": {
        "const": "about.discipline-list"
       }
      },
      "required": [
       "section"
      ]
     },
     "then": {
      "properties": {
       "content": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
         "items": {
          "type": "array",
          "items": {
           "type": "object",
           "additionalProperties": false,
           "properties": {
            "label": {
             "type": "string",
             "minLength": 1
            },
            "summary": {
             "type": "string",
             "minLength": 1
            },
            "media": {
             "$ref": "#/definitions/asset"
            }
           },
           "required": [
            "label",
            "summary"
           ]
          },
          "minItems": 2,
          "maxItems": 8
         }
        },
        "required": [
         "items"
        ]
       },
       "motion": {
        "properties": {
         "pattern": {
          "enum": [
           "opacity-hover"
          ]
         }
        }
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "section": {
        "const": "about.footer-meta"
       }
      },
      "required": [
       "section"
      ]
     },
     "then": {
      "properties": {
       "content": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
         "hint": {
          "type": "string",
          "minLength": 1
         },
         "facts": {
          "type": "array",
          "items": {
           "type": "string",
           "minLength": 1
          },
          "maxItems": 3
         }
        },
        "required": [
         "hint"
        ]
       },
       "motion": {
        "properties": {
         "pattern": {
          "enum": [
           "word-reveal"
          ]
         }
        }
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "section": {
        "const": "notfound.digits-scene"
       }
      },
      "required": [
       "section"
      ]
     },
     "then": {
      "properties": {
       "content": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
         "digits": {
          "type": "string",
          "pattern": "^[0-9]{3}$"
         }
        },
        "required": [
         "digits"
        ]
       },
       "motion": {
        "properties": {
         "pattern": {
          "enum": [
           "floating-digits"
          ]
         }
        }
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "section": {
        "const": "notfound.message"
       }
      },
      "required": [
       "section"
      ]
     },
     "then": {
      "properties": {
       "content": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
         "heading": {
          "type": "string",
          "minLength": 1
         },
         "body": {
          "type": "string",
          "minLength": 1
         },
         "backLinkLabel": {
          "type": "string",
          "minLength": 1
         },
         "backHref": {
          "type": "string",
          "minLength": 1
         }
        },
        "required": [
         "backHref",
         "backLinkLabel",
         "body",
         "heading"
        ]
       },
       "motion": {
        "properties": {
         "pattern": {
          "enum": [
           "opacity-hover"
          ]
         }
        }
       }
      }
     }
    }
   ]
  }
 }
}
